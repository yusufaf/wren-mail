<?xml version="1.0" encoding="utf-8"?>
<!-- The account's app password is stored in plain text, so none of Wren's data leaves the
     watch. allowBackup="false" covers cloud backup; this also stops device-to-device
     transfer, which Android 12+ still performs when allowBackup is false. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
