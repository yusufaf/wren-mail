<?xml version="1.0" encoding="utf-8"?>
<!-- None of Wren's data leaves the watch: the app password's Keystore key is never backed
     up, so a copy of the encrypted password would be useless elsewhere, and the rest is
     account and cache data. allowBackup="false" covers cloud backup; this also stops
     device-to-device transfer, which Android 12+ still performs when allowBackup is false. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
