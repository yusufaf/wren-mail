<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 counterpart of data_extraction_rules.xml. allowBackup="false" already turns
     backup off there; this keeps the data excluded if that ever changes. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
